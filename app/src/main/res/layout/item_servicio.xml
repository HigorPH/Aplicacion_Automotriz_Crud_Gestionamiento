<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#FFFBEB"
            app:strokeWidth="1dp"
            app:strokeColor="#FDE68A"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivFotoDano"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:padding="8dp"
                android:src="@drawable/ic_servicios"
                android:contentDescription="@string/modulo_servicios"
                app:tint="#D97706" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                tools:text="Mantenimiento general y cambio de aceite" />

            <TextView
                android:id="@+id/tvVehiculoInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#D97706"
                android:textStyle="bold"
                android:layout_marginTop="3dp"
                tools:text="🚘 Vehículo: Toyota Corolla (ABC-123)" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginTop="2dp"
                tools:text="📅 Fecha: 20/05/2025" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_action_circle_edit"
            android:src="@drawable/ic_edit"
            android:contentDescription="@string/editar"
            app:tint="#2563EB" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_action_circle_delete"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/eliminar"
            app:tint="#DC2626" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>